.git
.github

# Dependencies and generated build/test output.
**/node_modules
**/.next
**/dist
**/coverage
**/test-results
**/playwright-report

# Environment files: exclude secrets, allow documented examples only.
**/.env
**/.env.*
!.env.example
!**/.env.example
!.env.docker.example
!**/.env.docker.example

# Private credentials, certificates, logs, and local metadata.
**/*.pem
**/*.key
**/*.crt
**/*.log
**/.DS_Store
**/.manus-logs
