+/**
+ * Resolve the chat-completions URL.
+ * - OmniRoute mode: OMNIROUTE_BASE_URL like `http://localhost:20128/v1`
+ *   (trailing slash tolerated; a value already ending in /chat/completions is used as-is).
+ * - Default: Vercel AI Gateway.
+ */
+export function resolveGatewayUrl(baseUrl?: string): string {
+  const base = (baseUrl ?? process.env.OMNIROUTE_BASE_URL ?? "").trim().replace(/\/+$/, "");
+  if (!base) return DEFAULT_VERCEL_GATEWAY_URL;
+  if (base.endsWith("/chat/completions")) return base;
+  return `${base}/chat/completions`;
+}
+
+export function usesOmniRoute(baseUrl?: string): boolean {
+  return Boolean((baseUrl ?? process.env.OMNIROUTE_BASE_URL ?? "").trim());
+}
