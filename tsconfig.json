{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"],
      "@assets/*": ["./attached_assets/*"],
      "server/*": ["./server/*"]
    },
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "api/**/*.ts",
    "client/src/**/*.ts",
    "client/src/**/*.tsx",
    "drizzle/**/*.ts",
    "server/**/*.ts",
    "shared/**/*.ts",
    "*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "web",
    "jest.config.ts",
    "vitest.config.ts",
    "generate-registry.ts",
    "scan-skills.ts",
    "skill.ts",
    "utils.ts",
    "validate-skills.ts",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
