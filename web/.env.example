# Postgres connection string (Vercel adds this when you connect a Neon database)
DATABASE_URL=
# Long random string, e.g. output of: openssl rand -hex 32
SESSION_SECRET=
# First administrator, created on first deploy if no admin exists yet
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Your site's public address, e.g. https://www.nextedge-access-solutions.com
# Every OAuth redirect_uri is built from this, so it has to match the origin
# registered with Google and Facebook character-for-character, www included.
# Set it per environment: a preview deployment needs its own registered origin,
# otherwise the provider rejects the callback.
SITE_URL=
# Legacy alias for SITE_URL, still honoured. Prefer SITE_URL on new deployments.
APP_URL=
# Google sign-in and the YouTube / Business Profile connectors share one OAuth
# client (Google Cloud Console → APIs & Services → Credentials → OAuth client
# ID, type Web). Register both authorised redirect URIs on that client:
#   <SITE_URL>/api/auth/oauth/google/callback     website sign-in
#   <SITE_URL>/api/admin/social/callback/google   YouTube + Business Profile
#   <SITE_URL>/api/auth/admin/google/callback      Admin Panel Google SSO
# Explicit comma-separated allowlist for administrator-only Google SSO.
# This is separate from ADMIN_EMAIL and must contain only approved admin emails.
ADMIN_GOOGLE_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook sign-in (developers.facebook.com → Create App → Facebook Login)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
