# AI provider: leave blank to auto-select OpenRouter when its key exists, otherwise use the project-budgeted Vercel Gateway.
# You may explicitly set openrouter, vercel, gemini, groq, or xai to pin a provider.
# OpenRouter quota failures fall back to Groq only when GROQ_API_KEY is configured; no paid fallback is automatic.
NEAS_AI_PROVIDER=
# Store keys ONLY as server-side Vercel environment variables; never expose them to the browser.
# OpenRouter free chat routing (openrouter/free) and free Fish Audio S2.1 Pro TTS. Keep server-side only.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=

# Postgres connection string (Vercel adds this when you connect a Neon database)
DATABASE_URL=
# Long random string, e.g. output of: openssl rand -hex 32
SESSION_SECRET=
# Separate random secret for Vercel Cron / scheduled publishing (32+ characters).
CRON_SECRET=
# Dedicated AES-256-GCM key for admin-managed integration settings (64 hex characters).
# Generate with: openssl rand -hex 32. Do not reuse database, session, or cron credentials.
CONFIG_ENCRYPTION_KEY=
# Dedicated AES-256-GCM key for social OAuth tokens (64 hex characters).
# Generate with: openssl rand -hex 32. Do not reuse database, session, cron, or config keys.
TOKEN_ENCRYPTION_KEY=
# First administrator, created on first deploy if no admin exists yet
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Your site's public address, e.g. https://www.nextedge-access-solutions.com
# Every OAuth redirect_uri is built from this, so it has to match the origin
# registered with Google and Facebook character-for-character, www included.
# Set it per environment: a preview deployment needs its own registered origin,
# otherwise the provider rejects the callback.
SITE_URL=
# Legacy alias for SITE_URL, still honoured. Prefer SITE_URL on new deployments.
APP_URL=
# Google sign-in and the YouTube / Business Profile connectors share one OAuth
# client (Google Cloud Console ΓåÆ APIs & Services ΓåÆ Credentials ΓåÆ OAuth client
# ID, type Web). Register both authorised redirect URIs on that client:
#   <SITE_URL>/api/auth/oauth/google/callback     website sign-in
#   <SITE_URL>/api/admin/social/callback/google   YouTube + Business Profile
#   <SITE_URL>/api/admin/gmail/callback           NEAS Information / Operations Gmail OAuth
#   <SITE_URL>/api/auth/admin/google/callback      Admin Panel Google SSO
# Explicit comma-separated allowlist for administrator-only Google SSO.
# This is separate from ADMIN_EMAIL and must contain only approved admin emails.
ADMIN_GOOGLE_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Meta (Facebook Pages + Instagram Business; Instagram is connected through the selected Facebook Page).
# Register: <SITE_URL>/api/admin/social/callback/facebook in the Meta app's Valid OAuth Redirect URIs.
# Enable Facebook Login and request the required Page permissions. Set META_INSTAGRAM=1 only
# after the Meta app has Instagram Graph API access and the business account is linked to a Page.
META_APP_ID=
META_APP_SECRET=
META_INSTAGRAM=
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v25.0
# LinkedIn profile publishing. Register: <SITE_URL>/api/admin/social/callback/linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional separate LinkedIn app for Company Page publishing (requires Community Management API approval).
LINKEDIN_PAGES_CLIENT_ID=
LINKEDIN_PAGES_CLIENT_SECRET=
LINKEDIN_PAGES=
LINKEDIN_API_VERSION=202608
# TikTok publishing. Register: <SITE_URL>/api/admin/social/callback/tiktok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# YouTube upload visibility: private, unlisted, or public. Keep private until explicitly approved.
YOUTUBE_PRIVACY=private
# Self-hosted Rybbit analytics (see the Rybbit deploy runbook). Leave both blank
# and no analytics script is served anywhere. The site id is the number the Rybbit
# dashboard shows after you add the site. NEXT_PUBLIC_ is required: the Next.js
# pages read these in the browser bundle.
NEXT_PUBLIC_RYBBIT_HOST=
NEXT_PUBLIC_RYBBIT_SITE_ID=

# Rybbit analytics API (admin dashboard) - SERVER ONLY. Never use NEXT_PUBLIC_ for these.
RYBBIT_BASE_URL=https://analytics.nextedge-access-solutions.com
RYBBIT_SITE_ID=
RYBBIT_API_KEY=
